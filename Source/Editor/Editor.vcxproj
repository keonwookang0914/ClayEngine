<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Editor 모듈 : Editor.exe - Engine.dll 을 가져다 쓰는 실행 파일 -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{D708768C-B714-4D8E-931B-BFAE0DA10F02}</ProjectGuid>
    <RootNamespace>Editor</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\Build\ClayEngine.Common.props" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>Editor</TargetName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- F5 로 실행할 때의 작업 폴더를 저장소 루트로 맞춘다.
         셰이더·에셋을 상대 경로로 읽을 때 기준이 흔들리지 않는다. -->
    <LocalDebuggerWorkingDirectory>$(ClayRootDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Engine 의 Public 만 넣는다. Private 을 넣으면 내부 헤더에 손이 닿게 된다. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Private;$(ClayEnginePublicDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- WIN32 실행 파일. 진입점이 WinMain 이 되고 콘솔 창이 뜨지 않는다. -->
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Private\EditorMain.cpp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 이 참조 하나가 두 가지를 한다.
         1. 빌드 순서 - Engine 을 먼저 빌드한다.
         2. 링크      - Engine 의 import 라이브러리(Engine.lib)를 자동으로 링크한다. -->
    <ProjectReference Include="..\Engine\Engine.vcxproj">
      <Project>{acc0427c-ba91-4490-b362-c9e816245c38}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

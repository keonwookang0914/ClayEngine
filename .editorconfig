# ClayEngine 에디터 공통 설정
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ / HLSL
[*.{h,hpp,cpp,inl,hlsl,hlsli}]
indent_size = 4

# MSBuild / XML
[*.{vcxproj,filters,props,targets,sln,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
